
import SwiftUI

// =====================================================
// VIEW: EditNoteView
// =====================================================
// PURPOSE:
// Allows the user to edit an existing RecalllQ note.
//
// FEATURES:
// - Edit note title
// - Edit note content
// - Edit study reminder
// - Save changes
// - Cancel editing
// =====================================================

struct EditNoteView: View {

    // =====================================================
    // ENVIRONMENT
    // =====================================================

    @Environment(\.dismiss) private var dismiss

    // =====================================================
    // NOTE DATA
    // =====================================================

    let note: Note

    // =====================================================
    // EDITABLE FIELDS
    // =====================================================

    @State private var title: String
    @State private var content: String
    @State private var addReminder: Bool
    @State private var reminderDate: Date

    // =====================================================
    // CALLBACK
    // =====================================================

    let onSave: (
        String,
        String,
        Date?
    ) -> Void

    // =====================================================
    // INIT
    // =====================================================

    init(
        note: Note,
        onSave: @escaping (
            String,
            String,
            Date?
        ) -> Void
    ) {

        self.note = note
        self.onSave = onSave

        _title = State(
            initialValue: note.title
        )

        _content = State(
            initialValue: note.content
        )

        _addReminder = State(
            initialValue:
                note.reminderDate != nil
        )

        _reminderDate = State(
            initialValue:
                note.reminderDate
                ?? Calendar.current.date(
                    byAdding: .minute,
                    value: 5,
                    to: Date()
                )
                ?? Date()
        )
    }

    // =====================================================
    // BODY
    // =====================================================

    var body: some View {

        NavigationStack {

            Form {

                // =================================================
                // NOTE INFORMATION
                // =================================================

                Section {

                    TextField(
                        "Note title",
                        text: $title
                    )

                    TextField(
                        "What did you learn?",
                        text: $content,
                        axis: .vertical
                    )
                    .lineLimit(5...10)

                } header: {

                    Text("Study Note")
                }

                // =================================================
                // REMINDER
                // =================================================

                Section {

                    Toggle(
                        isOn: $addReminder
                    ) {

                        Label(
                            "Study Reminder",
                            systemImage:
                                "bell.fill"
                        )
                    }
                    .tint(
                        RecalllQTheme.secondary
                    )

                    if addReminder {

                        DatePicker(
                            "Review at",
                            selection:
                                $reminderDate,
                            in:
                                Date()...,
                            displayedComponents: [
                                .date,
                                .hourAndMinute
                            ]
                        )
                    }

                    if !addReminder,
                       note.reminderDate != nil {

                        Text(
                            "The existing reminder will be cancelled."
                        )
                        .font(.caption)
                        .foregroundColor(
                            RecalllQTheme.secondaryText
                        )
                    }

                } header: {

                    Text("Reminder")
                }

                // =================================================
                // NOTE INFORMATION
                // =================================================

                Section {

                    HStack {

                        Text("Created")

                        Spacer()

                        Text(
                            note.createdAt,
                            style: .date
                        )
                        .foregroundColor(
                            RecalllQTheme.secondaryText
                        )
                    }

                    HStack {

                        Text("Last Updated")

                        Spacer()

                        Text(
                            note.updatedAt,
                            style: .date
                        )
                        .foregroundColor(
                            RecalllQTheme.secondaryText
                        )
                    }

                } header: {

                    Text("Information")
                }
            }

            // =====================================================
            // NAVIGATION
            // =====================================================

            .navigationTitle(
                "Edit Note"
            )
            .navigationBarTitleDisplayMode(
                .inline
            )

            // =====================================================
            // TOOLBAR
            // =====================================================

            .toolbar {

                ToolbarItem(
                    placement:
                        .cancellationAction
                ) {

                    Button("Cancel") {

                        dismiss()
                    }
                }

                ToolbarItem(
                    placement:
                        .confirmationAction
                ) {

                    Button("Save") {

                        saveNote()
                    }
                    .fontWeight(.semibold)
                    .disabled(
                        title
                            .trimmingCharacters(
                                in:
                                    .whitespacesAndNewlines
                            )
                            .isEmpty
                        &&
                        content
                            .trimmingCharacters(
                                in:
                                    .whitespacesAndNewlines
                            )
                            .isEmpty
                    )
                }
            }
        }
    }

    // =====================================================
    // SAVE NOTE
    // =====================================================

    private func saveNote() {

        let cleanTitle =
            title.trimmingCharacters(
                in:
                    .whitespacesAndNewlines
            )

        let cleanContent =
            content.trimmingCharacters(
                in:
                    .whitespacesAndNewlines
            )

        guard
            !cleanTitle.isEmpty ||
            !cleanContent.isEmpty
        else {
            return
        }

        let newReminderDate =
            addReminder
            ? reminderDate
            : nil

        onSave(
            cleanTitle,
            cleanContent,
            newReminderDate
        )

        dismiss()
    }
}

